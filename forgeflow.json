{
  "mode": "auto",
  "adapter": "copilot",
  "auto_parallel": false,
  "blocker_timeout_minutes": 30,
  "root_artifact_dir": ".forgeflow/artifacts",
  "workflows": {
    "plan": {
      "name": "plan",
      "title": "Project Planning",
      "prompt_file": "adapter/codex/plan.prompt.md",
      "artifact": "Planning.md",
      "scope": "Project",
      "auto_next": "grill",
      "loops": false
    },
    "grill": {
      "name": "grill",
      "title": "Requirement Decomposition",
      "prompt_file": "adapter/codex/grill.prompt.md",
      "artifact": "Requirement-{Feature}.md",
      "scope": "Feature",
      "auto_next": "plan",
      "loops": true,
      "on_blocker_return": {
        "BUSINESS_GAP": "plan"
      }
    },
    "solution": {
      "name": "solution",
      "title": "Engineering Design",
      "prompt_file": "adapter/codex/solution.prompt.md",
      "artifact": "SolutionPlan.md",
      "scope": "Project",
      "auto_next": "slice",
      "loops": false,
      "on_blocker_return": {
        "ENGINEERING_GAP": "plan"
      }
    },
    "slice": {
      "name": "slice",
      "title": "Feature Decomposition",
      "prompt_file": "adapter/codex/slice.prompt.md",
      "artifact": "SlicePlan-{Feature}.md",
      "scope": "Feature",
      "auto_next": "plan",
      "loops": true
    },
    "tdd": {
      "name": "tdd",
      "title": "Test-Driven Development",
      "prompt_file": "adapter/copilot/tdd.prompt.md",
      "artifact": "TDDRecord-{Feature}-{Slice}.md",
      "scope": "Slice",
      "auto_next": "review",
      "loops": false
    },
    "review": {
      "name": "review",
      "title": "Quality Gate",
      "prompt_file": "adapter/copilot/review.prompt.md",
      "artifact": "ReviewReport-{Feature}-{Slice}.md",
      "scope": "Slice",
      "auto_next": "tdd",
      "loops": true
    }
  },
  "transitions": [
    {
      "rule_id": "plan_done_to_grill",
      "condition": "Plan DONE, first Feature missing Requirement",
      "forward": "grill",
      "return_to": null,
      "loops_back": false
    },
    {
      "rule_id": "solution_done_to_slice",
      "condition": "SolutionPlan DONE, first Slice missing",
      "forward": "slice",
      "return_to": null,
      "loops_back": false
    },
    {
      "rule_id": "review_pass_to_next",
      "condition": "ReviewReport PASS",
      "forward": "tdd",
      "return_to": null,
      "loops_back": true
    },
    {
      "rule_id": "review_fail_to_tdd_rework",
      "condition": "ReviewReport FAIL",
      "forward": null,
      "return_to": "tdd",
      "loops_back": true
    }
  ]
}